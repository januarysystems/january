# ================================================================
# JANUARY AI Provider Configuration (Phase 2)
# ================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env with real API keys to version control.
# ================================================================

# --------------------- Supabase Configuration ---------------------
# (Already configured - keep these)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# --------------------- OpenAI Configuration ---------------------
# Required for OpenAI provider (GPT-4o, GPT-4o-mini, GPT-4-turbo, etc.)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-792f6e5f54ab45ed91a5a3f3fb978f4b"

# Optional: Custom OpenAI-compatible endpoint (e.g., for local models)
# OPENAI_BASE_URL="https://api.openai.com/v1"

# --------------------- Anthropic Configuration -------------------
# Required for Anthropic provider (Claude 3.5 Sonnet, Haiku, Opus)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-anthropic-api-key-here"

# Optional: Custom Anthropic endpoint
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1/messages"

# --------------------- Google Gemini Configuration ---------------
# (Future support)
# Get your API key from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY="your-gemini-api-key"

# --------------------- OpenRouter Configuration ------------------
# (Future support)
# Get your API key from: https://openrouter.ai/
# OPENROUTER_API_KEY="your-openrouter-api-key"

# --------------------- Local Models Configuration ---------------
# (Future support for Ollama, LM Studio, etc.)
# OLLAMA_BASE_URL="http://localhost:11434"

# ================================================================
# IMPORTANT SECURITY NOTES:
# ================================================================
# 1. NEVER commit .env files with API keys to git
# 2. Add .env to your .gitignore file
# 3. Use different API keys for development and production
# 4. Rotate your keys regularly
# 5. Monitor API usage for unusual activity
# ================================================================

# ================================================================
# PROVIDER SELECTION:
# ================================================================
# Set your default AI provider and model:
# - provider: "openai" | "anthropic" | "google" | "openrouter" | "local"
# - model: The specific model identifier (e.g., "gpt-4o-mini")

# Default provider (recommended: openai for cost-effective, anthropic for quality)
DEFAULT_AI_PROVIDER="openai"
DEFAULT_AI_MODEL="gpt-4o-mini"

# ================================================================
# MODEL REFERENCE:
# ================================================================
# OpenAI Models:
# - gpt-4o (Most capable)
# - gpt-4o-mini (Fast, cost-effective) - RECOMMENDED
# - gpt-4-turbo (Legacy)
# - gpt-3.5-turbo (Fastest, legacy)
# - o1-mini (Reasoning)
# - o1-preview (Advanced reasoning)

# Anthropic Models:
# - claude-3-5-sonnet-20241022 (Most capable)
# - claude-3-5-haiku-20241022 (Fast, cost-effective)
# - claude-3-opus-20240229 (Legacy)
# - claude-3-sonnet-20240229 (Legacy)
# - claude-3-haiku-20240307 (Legacy)
